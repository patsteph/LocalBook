# LocalBook Backend Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# Models
# =============================================================================
# One setting per role, each naming a Hugging Face MLX checkpoint. Everything runs
# IN-PROCESS on Apple MLX — there is no server to point at and no base URL to set.
#
# Prefer LLM Studio in the app: it lists only models actually downloaded on this Mac, and a
# role pointed at something that is not there fails at first use. These env vars exist for
# per-machine overrides and scripted setups.
#
# ⚠️ A model with no row in evaluator/registry_data/known_models.json silently loses its
# curated tuning (context cap, stop sequences, temperature). No error — the tuning just
# stops applying.
MAIN_MODEL=mlx-community/gemma-4-e4b-it-4bit
FAST_MODEL=mlx-community/Phi-4-mini-instruct-4bit
# Option A: the vision-capable main model absorbs the vision slot, so this is deliberately
# the SAME checkpoint — one gemma resident, not two.
VISION_MODEL=mlx-community/gemma-4-e4b-it-4bit
IMAGE_MODEL=Runpod/FLUX.2-klein-4B-mflux-4bit

# =============================================================================
# Embedding Settings
# =============================================================================
# NOTE: changing this requires re-indexing every document:
#   curl -X POST http://localhost:8000/reindex/all
# bf16 is pinned deliberately — measured against the stored index it produces 0/50 top-1
# retrieval changes where the 8-bit build produces 1/50. Re-run
# backend/scripts/embedding_equivalence.py before switching to save the ~0.5 GB.
EMBEDDING_MODEL=mlx-community/snowflake-arctic-embed-l-v2.0-bf16

# =============================================================================
# Chunking Settings (affects retrieval quality)
# =============================================================================
# Characters per chunk (smaller = more precise, larger = more context)
CHUNK_SIZE=1000

# Overlap between chunks (higher = better continuity)
CHUNK_OVERLAP=200

# Recommended settings by use case:
# - Technical docs:    CHUNK_SIZE=800,  CHUNK_OVERLAP=150
# - Long narratives:   CHUNK_SIZE=1200, CHUNK_OVERLAP=250
# - Mixed content:     CHUNK_SIZE=1000, CHUNK_OVERLAP=200 (default)

# =============================================================================
# Server Settings
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
